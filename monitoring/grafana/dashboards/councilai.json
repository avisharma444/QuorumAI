          "expr": "histogram_quantile(0.95, sum by (le, strategy) (rate(councilai_council_response_seconds_bucket[5m])))",
          "legendFormat": "p95 {{strategy}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cache hit ratio (L1 exact, L2 semantic)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Ratios over lookups actually performed; bypassed, disabled and ineligible lookups are excluded.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(councilai_cache_operations_total{level=\"l1_exact\",result=\"hit\"}[5m])) / sum(rate(councilai_cache_operations_total{level=\"l1_exact\",result=~\"hit|miss\"}[5m]))",
          "legendFormat": "L1 hits / L1 lookups",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(councilai_cache_operations_total{level=\"l2_semantic\",result=\"hit\"}[5m])) / sum(rate(councilai_cache_operations_total{level=\"l2_semantic\",result=~\"hit|miss\"}[5m]))",
          "legendFormat": "L2 hits / L2 lookups",
          "refId": "B"
        }
      ]
    },
