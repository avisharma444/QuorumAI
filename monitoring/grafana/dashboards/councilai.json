          },
          "expr": "histogram_quantile(0.5, sum by (le, strategy) (rate(councilai_council_response_seconds_bucket[5m])))",
          "legendFormat": "p50 {{strategy}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
