# Run offline with deterministic mock model responses (safe default).
MOCK_LLM=true
# To use real OpenAI-compatible providers such as OpenRouter:
# MOCK_LLM=false
# MODEL_API_KEY=YOUR_KEY
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# COUNCIL_MODELS=provider/model-a,provider/model-b,provider/model-c
# CHAIR_MODEL=provider/chairman-model
