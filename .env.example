# Offline mode: deterministic mock clients, no network calls, no cost.
# This must be set explicitly; a misconfigured real provider never falls
# back to mock answers.
MOCK_LLM=true

# Real providers: set MOCK_LLM=false and add a key for every provider that
# config.yaml (or the overrides below) uses. Keys are read only from the
# environment, never from config.yaml. Startup fails and names any missing key.
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_NIM_API_KEY=

# Optional overrides of config.yaml (each role is independent):
# COUNCIL_1_PROVIDER=openrouter
# COUNCIL_1_MODEL=openrouter/free
# COUNCIL_2_PROVIDER=gemini
# COUNCIL_2_MODEL=gemini-2.5-flash
# COUNCIL_3_PROVIDER=nvidia-nim
# COUNCIL_3_MODEL=meta/llama-3.1-8b-instruct
# CHAIRMAN_PROVIDER=gemini
# CHAIRMAN_MODEL=gemini-2.5-flash
# STAGE_TIMEOUT=30s
# Per-model vLLM server, e.g. VLLM_MICROSOFT_PHI_4_MINI_INSTRUCT_URL=http://host:8001/v1/chat/completions

# Redis Stack caches (L1 exact, L2 semantic, document summaries).
# REDIS_ENABLED=false turns caching off entirely (there is no in-process fallback).
# REDIS_PASSWORD=          # for an external, password-protected Redis
# REDIS_MAXMEMORY=512mb    # compose: Redis maxmemory (volatile-lru)
# SEMANTIC_CACHE_THRESHOLD=0.85   # see README: measured false-positive rates
